//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD *
000001HENRIQUE BATISTA              319999900000001BELO HORIZONTE               
000002MARIA CLAUDIA                 319999900000002BELO HORIZONTE               
000003VINICIUS JUNIOR               219999900000003RIO DE JANEIRO               
000004GABRIELA SILVA                319999900000004CONTAGEM                     
