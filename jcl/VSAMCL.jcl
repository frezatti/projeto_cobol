//VSAMCLIE JOB (COBOL),'VSAM CLIE',CLASS=A,MSGCLASS=X,
//         MSGLEVEL=(1,1),NOTIFY=HERC01,REGION=4096K,TIME=1440
//APAGA    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE HERC01.CLIENTES.CLIE.KSDS CLUSTER PURGE
  IF LASTCC = 8 THEN SET MAXCC = 0
/*
//CRIA     EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE CLUSTER (NAME(HERC01.CLIENTES.CLIE.KSDS) -
                  INDEXED -
                  UNIQUE -
                  KEYS(6 0) -
                  RECORDSIZE(80 80) -
                  TRACKS(5 1) -
                  VOLUMES(WORK01) -
                  SHAREOPTIONS(2 3)) -
         DATA (NAME(HERC01.CLIENTES.CLIE.KSDS.DATA)) -
         INDEX (NAME(HERC01.CLIENTES.CLIE.KSDS.INDEX))
/*
